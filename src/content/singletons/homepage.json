    "testimonies": {
      "eyebrow": {
        "uk": "Свідчення",
        "en": "Testimonies"
      },
      "title": {
        "uk": "Історії змінених життів",
        "en": "Stories of changed lives"
      },
      "all": {
        "uk": "Усі свідчення",
        "en": "All Testimonies"
      },
      "allUrl": null,
      "items": [
        {
          "text": {
            "uk": {
              "type": "doc",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "У цій церкві я знайшла надію й нову родину. Бог відновив моє життя, коли, здавалося, все було втрачено."
                    }
                  ]
                }
              ]
            },
            "en": {
              "type": "doc",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "In this church I found hope and a new family. God restored my life when everything seemed lost."
                    }
                  ]
                }
              ]
            }
          },
          "name": {
            "uk": "Олена К.",
            "en": "Olena K."
          },
          "role": {
            "uk": "членкиня церкви",
            "en": "church member"
          }
        },
        {
          "text": {
            "uk": {
              "type": "doc",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Домашня група стала для мене місцем справжньої підтримки й духовного зростання протягом складного року."
                    }
                  ]
                }
              ]
            },
            "en": {
              "type": "doc",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "My home group became a place of real support and spiritual growth through a difficult year."
                    }
                  ]
                }
              ]
            }
          },
          "name": {
            "uk": "Андрій М.",
            "en": "Andrii M."
          },
          "role": {
            "uk": "лідер групи",
            "en": "group leader"
          }
        },
        {
          "text": {
            "uk": {
              "type": "doc",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Прийшла на служіння вперше і відчула любов Божу так реально. Відтоді моє життя змінилося назавжди."
                    }
                  ]
                }
              ]
            },
            "en": {
              "type": "doc",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "I came to a service for the first time and felt God’s love so real. My life has never been the same."
                    }
                  ]
                }
              ]
            }
          },
          "name": {
            "uk": "Марія Т.",
            "en": "Maria T."
          },
          "role": {
            "uk": "волонтерка",
            "en": "volunteer"
          }
        },
        {
          "text": {
            "uk": {
              "type": "doc",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Тут я вперше зрозумів, що таке прощення. Служіння турботи допомогло мені відновити стосунки з рідними."
                    }
                  ]
                }
              ]
            },
            "en": {
              "type": "doc",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Here I first understood forgiveness. The care ministry helped me restore my relationships."
                    }
                  ]
                }
              ]
            }
          },
          "name": {
            "uk": "Віталій С.",
            "en": "Vitalii S."
          },
          "role": {
            "uk": "член церкви",
            "en": "church member"
          }
        }
      ]
    },
