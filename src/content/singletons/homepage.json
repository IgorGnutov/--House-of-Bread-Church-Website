    "about": {
      "eyebrow": {
        "uk": "Про церкву",
        "en": "About the Church"
      },
      "title": {
        "uk": "Наше бачення: Царство Боже у Кривому Розі й до краю землі!",
        "en": "Our Vision: The Kingdom of God in Kryvyi Rih and to the Ends of the Earth!"
      },
      "lead": {
        "uk": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Ми — спільнота людей, які пережили зустріч з Богом і живуть Його любов'ю. Наша мета — духовне пробудження міста, служіння ближньому та вплив на суспільство через Євангеліє Ісуса Христа."
                }
              ]
            }
          ]
        },
        "en": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "We are a community of people who have met God and now live by His love. Our purpose is the spiritual revival of our city, serving our neighbours, and impacting society through the Gospel of Jesus Christ."
                }
              ]
            }
          ]
        }
      },
      "beliefsTitle": {
        "uk": "На чому ми стоїмо",
        "en": "What We Stand On"
      }
    },
    "beliefs": [
      {
        "uk": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Біблія — богонатхненне, непомильне Слово Боже й найвищий авторитет для життя і віри."
                }
              ]
            }
          ]
        },
        "en": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "The Bible is the inspired, infallible Word of God and the highest authority for life and faith."
                }
              ]
            }
          ]
        }
      },
      {
        "uk": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Триєдиний Бог — Отець, Син і Святий Дух — вічний у трьох Особах."
                }
              ]
            }
          ]
        },
        "en": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "The Triune God — Father, Son and Holy Spirit — eternal in three Persons."
                }
              ]
            }
          ]
        }
      },
      {
        "uk": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Спасіння — це дар благодаті, який приймається вірою в Ісуса Христа."
                }
              ]
            }
          ]
        },
        "en": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Salvation is a gift of grace received through faith in Jesus Christ."
                }
              ]
            }
          ]
        }
      },
      {
        "uk": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Водне хрещення за вірою як свідчення нового життя у Христі."
                }
              ]
            }
          ]
        },
        "en": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Water baptism by faith as a testimony of new life in Christ."
                }
              ]
            }
          ]
        }
      },
      {
        "uk": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Хрещення Святим Духом та дари Духа для сьогоднішньої Церкви."
                }
              ]
            }
          ]
        },
        "en": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "The baptism of the Holy Spirit and the gifts of the Spirit for today’s Church."
                }
              ]
            }
          ]
        }
      },
      {
        "uk": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Свята Вечеря (Причастя) як спомин про жертву Ісуса Христа."
                }
              ]
            }
          ]
        },
        "en": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "The Lord’s Supper (Communion) in remembrance of the sacrifice of Jesus Christ."
                }
              ]
            }
          ]
        }
      },
      {
        "uk": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Друге пришестя Ісуса Христа й вічне життя з Богом."
                }
              ]
            }
          ]
        },
        "en": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "The Second Coming of Jesus Christ and eternal life with God."
                }
              ]
            }
          ]
        }
      }
    ],
