          },
          "text": {
            "uk": {
              "type": "doc",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Біблія — основа нашого вчення та життя."
                    }
                  ]
                }
              ]
            },
            "en": {
              "type": "doc",
              "content": [
