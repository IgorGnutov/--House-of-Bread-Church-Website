---
import SubPage from '../../../layouts/SubPage.astro';
import Icon from '../../../components/Icon.astro';
import { t, pick, plural } from '../../../i18n';
import { assetUrl, localePath, localeParams } from '../../../lib/paths.mjs';
import { notFound, pageLang } from '../../../lib/routing.mjs';
import { siteData } from '../../../lib/site-data';
import { coverImage } from '../../../lib/collections.mjs';
import { pageDescription } from '../../../lib/seo.mjs';
import { ARROW } from '../../../lib/svg.mjs';
import '../../../styles/pages/ministries.css';

export function getStaticPaths() {
  return localeParams();
}

const store = await siteData(Astro.locals);
const lang = pageLang(Astro);
if (!lang) return notFound();
const base = import.meta.env.BASE_URL;
const page = store.page('ministries');
const ministries = store.list('ministries');
const home = localePath(base, lang, '/');
---
<SubPage
  lang={lang}
  title={pick(page.title, lang)}
  path="/ministries/"
  description={pageDescription(page, lang)}
  seo={page.seo}
  back={{ href: localePath(base, lang, '/#ministries'), label: t(lang, 'back.home') }}
  footBack={{ href: home, label: t(lang, 'footBack.home') }}
>
<section class="page-hero">
  <div class="container">
    <span class="hero-count" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18V6l10-2v12"/><circle cx="6" cy="18" r="3"/><circle cx="16" cy="16" r="3"/></svg><span>{plural(lang, 'count.ministries', ministries.length)}</span></span>
    {page.eyebrow && <p class="eyebrow">{pick(page.eyebrow, lang)}</p>}
    <h1>{pick(page.title, lang)}</h1>
    {page.lead && <p>{pick(page.lead, lang)}</p>}
  </div>
</section>

{/* Порожня колекція — без порожньої сітки: лишається герой з лічильником «0». */}
{ministries.length > 0 && (
<section class="section">
  <div class="container">
    <div class="min-grid">
      {ministries.map((m) => (
        <a class="min-card" href={localePath(base, lang, `/ministries/${m.slug}/`)}>
          <div class="min-thumb"><img loading="lazy" src={assetUrl(base, coverImage(m.media).src)} alt={pick(m.name, lang)}>
            <span class="icon" aria-hidden="true"><Icon set="ministry" name={m.icon} /></span>
          </div>
          <div class="min-body">
            <h3>{pick(m.name, lang)}</h3>
            <p>{pick(m.summary, lang)}</p>
            <div class="min-foot"><span class="min-go">{t(lang, 'card.readMore')} <Fragment set:html={ARROW} /></span></div>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
)}
</SubPage>
